{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caesariodito/.standardization/harness/schemas/issue-plan-v1.json",
  "title": "Issue Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcome", "problem", "evidence", "background", "unknowns", "proposedSolution", "implementationPlan", "acceptanceCriteria", "risks", "outOfScope", "expectedFiles", "changesFromPreviousPlan", "feedbackAddressed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "outcome": { "enum": ["ready", "needs-input"] },
    "problem": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "evidence": { "$ref": "#/$defs/nonEmptyStrings" },
    "background": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "unknowns": { "$ref": "#/$defs/strings" },
    "proposedSolution": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "implementationPlan": { "$ref": "#/$defs/nonEmptyStrings" },
    "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStrings" },
    "risks": { "$ref": "#/$defs/strings" },
    "outOfScope": { "$ref": "#/$defs/strings" },
    "expectedFiles": { "$ref": "#/$defs/paths" },
    "changesFromPreviousPlan": { "$ref": "#/$defs/strings" },
    "feedbackAddressed": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "strings": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
    "paths": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$" } }
  }
}
